# ---------------------------------------------------------------------------
# Planet Health â€” root environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` in the repository root.  Docker Compose reads this file
# automatically; the backend also loads `backend/.env` for non-Docker runs.
#
#   cp .env.example .env

# --- Ports ------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=planethealth
POSTGRES_PASSWORD=planethealth
POSTGRES_DB=planethealth

# --- Application ------------------------------------------------------------
APP_NAME=Planet Health API
APP_ENV=development
DEBUG=false
API_PREFIX=/api

# --- Security ---------------------------------------------------------------
# CHANGE THIS before deploying. The backend refuses to start in production
# with the default value.
SECRET_KEY=planet-health-development-secret-change-me
SESSION_COOKIE_NAME=ph_session
CSRF_COOKIE_NAME=ph_csrf
SESSION_HINT_COOKIE_NAME=ph_session_hint
SESSION_LIFETIME_SECONDS=43200
SESSION_REMEMBER_LIFETIME_SECONDS=2592000
SESSION_REFRESH_INTERVAL_SECONDS=900
# Set to true when the application is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Origins ----------------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_APP_URL=http://localhost:3000

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png

# --- Models -----------------------------------------------------------------
# Set INSTALL_ML_DEPS=false for a smaller, faster image while the model
# checkpoints are not yet installed.
INSTALL_ML_DEPS=true
MODEL_LOAD_ON_STARTUP=true
MODEL_DEVICE=auto
MODEL_GROWTH_CHECKPOINT=models/growth/growth_model.pth
MODEL_STRESS_CHECKPOINT=models/stress/stress_model.pth
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_TIMEOUT_SECONDS=120

# --- Frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_CSRF_COOKIE_NAME=ph_csrf
NEXT_PUBLIC_SESSION_HINT_COOKIE_NAME=ph_session_hint
INTERNAL_API_URL=http://backend:8000

# --- Email delivery (password reset) ----------------------------------------
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@planethealth.local

