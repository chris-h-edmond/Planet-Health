# ---------------------------------------------------------------------------
# Planet Health â€” backend environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and adjust.  Every value can also be supplied as a real
# environment variable (which takes precedence in Docker Compose).

# --- Application -----------------------------------------------------------
APP_NAME="Planet Health API"
APP_ENV=development
DEBUG=false
API_PREFIX=/api

# --- Database --------------------------------------------------------------
DATABASE_URL="postgresql+psycopg://planethealth:planethealth@localhost:5432/planethealth"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- Security --------------------------------------------------------------
# CHANGE THIS before deploying anywhere. The backend refuses to start with
# the default value when APP_ENV=production.
SECRET_KEY="change-me-to-a-long-random-value"
SESSION_COOKIE_NAME=ph_session
CSRF_COOKIE_NAME=ph_csrf
# A readable marker telling the browser that a session may exist. It carries
# no authority and only avoids an unnecessary 401 request.
SESSION_HINT_COOKIE_NAME=ph_session_hint
SESSION_LIFETIME_SECONDS=43200
SESSION_REMEMBER_LIFETIME_SECONDS=2592000
SESSION_REFRESH_INTERVAL_SECONDS=900
# Set to true once the application is served over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.planethealth.example.com

# --- Origins ---------------------------------------------------------------
# Comma separated. Used for CORS and for the Origin / Referer CSRF check.
CORS_ALLOW_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Rate limiting ---------------------------------------------------------
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
REGISTER_RATE_LIMIT_ATTEMPTS=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600

# --- Uploads ---------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png"
MAX_IMAGE_PIXELS=40000000

# --- Models ----------------------------------------------------------------
# Checkpoint paths are relative to the backend package root unless absolute.
MODEL_GROWTH_CHECKPOINT="models/growth/growth_model.pth"
MODEL_STRESS_CHECKPOINT="models/stress/stress_model.pth"
MODEL_LOAD_ON_STARTUP=true
# auto | cpu | cuda
MODEL_DEVICE=auto
INFERENCE_MAX_CONCURRENCY=1
INFERENCE_TIMEOUT_SECONDS=120

# --- Email delivery (password reset) ---------------------------------------
# Password reset is only offered when a real SMTP transport is configured.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="no-reply@planethealth.local"
SMTP_USE_TLS=true
PUBLIC_APP_URL=http://localhost:3000

