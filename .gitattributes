# Auto detect text files and perform LF normalization
* text=auto

# ---------------------------------------------------------------------------
# Planet Health — binary and model artifact handling
# ---------------------------------------------------------------------------
# NOTE: the first line above is the repository default and is preserved
# verbatim. Everything below refines it.

# --- Model checkpoints (plain Git, no LFS) --------------------------------
# The trained ResNet-18 checkpoints are ~43 MB each and are tracked in plain
# Git — Git LFS is not used for this repository.
#
# They must never be text-normalised, so they are explicitly marked binary.
# `* text=auto` above already detects them as binary, this rule makes the
# intent explicit and protects against any future change to that default.
*.pth binary
*.pt binary
*.onnx binary
*.ckpt binary

# --- Other binary assets ----------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.whl binary
*.so binary
*.dylib binary
*.dll binary
*.exe binary

# --- Lockfiles keep LF -----------------------------------------------------
package-lock.json text eol=lf
pnpm-lock.yaml text eol=lf
yarn.lock text eol=lf
uv.lock text eol=lf

# --- Explicitly keep model directory placeholders tracked ------------------
backend/models/**/.gitkeep text eol=lf
