# ---------------------------------------------------------------------------
# Planet Health — repository ignore rules
# ---------------------------------------------------------------------------

# --- Environment / secrets -------------------------------------------------
.env
.env.*
!.env.example
*.local

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pytest_tmp/
.coverage
htmlcov/

# --- Node / Next.js --------------------------------------------------------
node_modules/
.next/
out/
build/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Model artifacts -------------------------------------------------------
# The trained checkpoints are intentionally TRACKED in plain Git (no Git LFS).
#   backend/models/growth/growth_model.pth
#   backend/models/stress/stress_model.pth
# They are large binaries, so .gitattributes marks them as binary to make sure
# Git never applies text normalisation to them. Only ad-hoc scratch
# checkpoints outside the repository are ignored.
*.pth.tmp
*.part

# --- Runtime data ----------------------------------------------------------
postgres_data/
.pgdata/
var/
tmp/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
